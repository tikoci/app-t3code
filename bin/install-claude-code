#!/bin/bash
# install-claude-code: install Claude Code's native build into the home
# (~/.local/share/claude/versions/<ver>, linked from ~/.local/bin/claude), the
# layout Anthropic's own installer produces. The image never ships Claude (its
# license forbids redistribution), so the entrypoint runs this in the
# background on every start until a `claude` is on PATH.
#
#   install-claude-code [--keep-trying] [stable|latest|X.Y.Z]   (default: stable)
#
# It follows Anthropic's install.sh (https://claude.ai/install.sh) with one
# download instead of two: read the channel pointer, then
# <ver>/manifest.json's .platforms[<platform>] {checksum, size}; download
# <ver>/<platform>/claude.zst (resumable, about a third of the size) and
# decompress it with the image's zstd, check the binary's size and SHA-256,
# stage it as versions/<ver>, then run `<it> install <ver>`. The manifest has
# no entry for the .zst, so only the decompressed binary is verified, as
# install.sh does. Without zstd, when the .zst answers with an HTTP error, or
# when an uncompressed partial is already there, it downloads
# <ver>/<platform>/claude itself instead. Claude's installer finds the
# staged version and only writes the launcher link and its own settings
# (about 25 KiB of traffic, measured 2026-11-08 with 2.1.311).
# scripts/freshness.ts `claude` checks this manifest contract, and that both
# downloads exist, daily.
#
# A `claude` already on PATH (installed by hand, by T3's /welcome, or by an
# earlier run) always wins: nothing is downloaded or replaced. A verified
# binary left by an interrupted run is reused. --keep-trying retries for about
# a day (routers often start containers before the uplink is up); without it,
# one attempt. Exit 0 when installed or already present, 1 on failure.
#
# The binary download gives up on a stalled connection (under 1 KiB/s for two
# minutes) and after two hours, then resumes; a server that refuses to resume
# restarts it from zero.
#
# Test hooks: CLAUDE_CODE_RELEASES_URL (download base), INSTALL_CLAUDE_CODE_BACKOFF
# (space-separated seconds between --keep-trying rounds),
# INSTALL_CLAUDE_CODE_STALL_SECONDS (stall limit, default 120),
# INSTALL_CLAUDE_CODE_ZSTD (the zstd command, default zstd).
set -euo pipefail

RELEASES_URL="${CLAUDE_CODE_RELEASES_URL:-https://downloads.claude.ai/claude-code-releases}"
# Same schedule as `t3code-tools install --keep-trying`: 15s, 1m, 5m, 15m, 30m, then hourly.
BACKOFF="${INSTALL_CLAUDE_CODE_BACKOFF:-15 60 300 900 1800 3600 3600 3600 3600 3600 3600 3600 3600 3600 3600 3600 3600 3600 3600 3600 3600 3600 3600 3600 3600 3600 3600 3600}"

STALL_SECONDS="${INSTALL_CLAUDE_CODE_STALL_SECONDS:-120}"
ZSTD="${INSTALL_CLAUDE_CODE_ZSTD:-zstd}"
VERSION_RE='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'

usage() { echo "usage: install-claude-code [--keep-trying] [stable|latest|X.Y.Z]" >&2; exit 2; }
log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) install-claude-code: $*"; }

keep_trying=false
target=stable
for arg in "$@"; do
	case "$arg" in
	--keep-trying) keep_trying=true ;;
	stable | latest) target="$arg" ;;
	-h | --help) usage ;;
	*)
		[[ "$arg" =~ $VERSION_RE ]] || usage
		target="$arg"
		;;
	esac
done

if [ "$(id -u)" -eq 0 ]; then
	echo "install-claude-code: run it as the app user (node), not root; it installs into that user's home" >&2
	exit 1
fi

case "$(uname -m)" in
x86_64 | amd64) platform=linux-x64 ;;
aarch64 | arm64) platform=linux-arm64 ;;
*) echo "install-claude-code: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

versions_dir="${HOME}/.local/share/claude/versions"
downloads_dir="${HOME}/.claude/downloads"
mkdir -p "$downloads_dir"

lock="${downloads_dir}/.install-claude-code.lock"

present() {
	local found
	found="$(command -v claude 2>/dev/null)" || return 1
	log "claude already installed: ${found} ($(claude --version 2>/dev/null || echo 'version unknown'))"
}

sha256_of() { sha256sum "$1" | cut -d' ' -f1; }

# One attempt under the lock: 0 installed or present, 1 failed, 2 another
# install-claude-code holds the lock (the entrypoint's background run and a
# manual one). The lock is released between --keep-trying rounds.
attempt() {
	local status=0 rc=0
	# set -e is off in functions called from a condition: check every step.
	if ! { exec 9>"$lock"; } 2>/dev/null; then
		log "cannot open the lock file ${lock}"
		return 1
	fi
	flock -n -E 75 9 || rc=$?
	case "$rc" in
	0) try_install || status=$? ;;
	# Busy, but T3's /welcome Install may already have finished: that is success.
	75) present || status=2 ;;
	*)
		log "cannot lock ${lock} (flock exit ${rc})"
		status=1
		;;
	esac
	exec 9>&-
	return "$status"
}

# Fetch $2 into $1, resuming a partial: up to three curl runs. A server that
# refuses to resume (curl exit 33) restarts from zero. An HTTP error (curl
# exit 22) returns 22 at once; any other failure returns 1.
download() {
	local part="$1" url="$2" rc try
	for try in 1 2 3; do
		rc=0
		curl -fsSL --connect-timeout 30 --speed-limit 1024 --speed-time "$STALL_SECONDS" --max-time 7200 \
			--continue-at - -o "$part" "$url" || rc=$?
		case "$rc" in
		0) return 0 ;;
		22) return 22 ;;
		33)
			log "the server refused to resume; downloading from the start"
			rm -f "$part"
			;;
		*)
			log "download stopped (curl exit ${rc}) at $(($(stat -c %s "$part" 2>/dev/null || echo 0) / 1048576)) MiB"
			[ "$try" -lt 3 ] && sleep 1
			;;
		esac
	done
	return 1
}

# Fill $1 with the uncompressed Claude Code $2 (manifest size $3; $4 bytes
# already there). The caller checks it against the manifest either way.
fetch_binary() {
	local part="$1" version="$2" size="$3" have="$4" rc=0
	local url="${RELEASES_URL}/${version}/${platform}/claude"
	if [ "$have" -eq 0 ] && command -v "$ZSTD" >/dev/null 2>&1; then
		local zpart="${part%.part}.zst.part"
		log "downloading Claude Code ${version} (${platform}, compressed$([ -s "$zpart" ] && echo ", resuming at $(($(stat -c %s "$zpart") / 1048576)) MiB"))"
		download "$zpart" "${url}.zst" || rc=$?
		case "$rc" in
		0)
			# A .zst that does not decompress is discarded: the next attempt starts over.
			if "$ZSTD" -dqf "$zpart" -o "$part"; then
				rm -f "$zpart"
				return 0
			fi
			rm -f "$zpart" "$part"
			log "the compressed download did not decompress; discarded"
			return 1
			;;
		22)
			rm -f "$zpart"
			log "no compressed build (HTTP error); downloading the uncompressed one"
			;;
		*)
			log "download interrupted; a later attempt resumes it"
			return 1
			;;
		esac
	fi
	log "downloading Claude Code ${version} (${platform}, $((size / 1048576)) MiB$([ "$have" -gt 0 ] && echo ", resuming at $((have / 1048576)) MiB"))"
	if ! download "$part" "$url"; then
		log "download interrupted; a later attempt resumes it"
		return 1
	fi
}

try_install() {
	present && return 0

	local version manifest checksum size
	if [ "$target" = stable ] || [ "$target" = latest ]; then
		version="$(curl -fsSL --retry 3 --max-time 60 "${RELEASES_URL}/${target}" | tr -d '[:space:]')" || {
			log "cannot read the ${target} channel at ${RELEASES_URL}/${target}"
			return 1
		}
		# An HTML error page or a proxy notice must not reach the manifest URL.
		if [[ ! "$version" =~ $VERSION_RE ]]; then
			log "the ${target} channel returned '${version:0:60}', not a version"
			return 1
		fi
	else
		version="$target"
	fi

	manifest="$(curl -fsSL --retry 3 --max-time 60 "${RELEASES_URL}/${version}/manifest.json")" || {
		log "cannot read ${RELEASES_URL}/${version}/manifest.json"
		return 1
	}
	local manifest_version
	manifest_version="$(jq -r '.version // empty' <<<"$manifest" 2>/dev/null)" || manifest_version=""
	if [ -n "$manifest_version" ] && [ "$manifest_version" != "$version" ]; then
		log "${RELEASES_URL}/${version}/manifest.json says version ${manifest_version}, not ${version}"
		return 1
	fi
	checksum="$(jq -r --arg p "$platform" '.platforms[$p].checksum // empty' <<<"$manifest" 2>/dev/null)" || checksum=""
	size="$(jq -r --arg p "$platform" '.platforms[$p].size // empty' <<<"$manifest" 2>/dev/null)" || size=""
	if [[ ! "$checksum" =~ ^[a-f0-9]{64}$ ]] || [[ ! "$size" =~ ^[1-9][0-9]*$ ]]; then
		log "Claude Code ${version} manifest has no ${platform} checksum and size (.platforms[\"${platform}\"]); the manifest format may have changed"
		return 1
	fi

	local staged="${versions_dir}/${version}"
	# A verified file that cannot be made executable is replaced, not reused.
	if [ -f "$staged" ] && [ "$(stat -c %s "$staged")" = "$size" ] && [ "$(sha256_of "$staged")" = "$checksum" ] &&
		{ [ -x "$staged" ] || chmod 0755 "$staged" 2>/dev/null; }; then
		log "reusing the verified ${staged}"
	else
		local part="${downloads_dir}/claude-${version}-${platform}.part" have=0
		[ -f "$part" ] && have="$(stat -c %s "$part")"
		# A partial larger than the target, or a full-size one that fails the
		# checksum, is a different file: start over. A complete one needs no request.
		if [ "$have" -gt "$size" ] || { [ "$have" -eq "$size" ] && [ "$(sha256_of "$part")" != "$checksum" ]; }; then
			rm -f "$part"
			have=0
		fi
		if [ "$have" -ne "$size" ] && ! fetch_binary "$part" "$version" "$size" "$have"; then
			return 1
		fi
		if [ "$(stat -c %s "$part")" != "$size" ] || [ "$(sha256_of "$part")" != "$checksum" ]; then
			rm -f "$part"
			log "Claude Code ${version} failed its size or SHA-256 check against the manifest; discarded"
			return 1
		fi
		# T3's /welcome Install (Anthropic's install.sh) may have finished meanwhile.
		if present; then
			rm -f "$part"
			return 0
		fi
		# set -e is off inside a function called from a condition: check each step.
		if ! { chmod 0755 "$part" && mkdir -p "$versions_dir" && mv -f "$part" "$staged"; }; then
			log "cannot stage ${staged}"
			return 1
		fi
	fi

	present && return 0
	log "setting up Claude Code ${version}"
	if ! "$staged" install "$version" </dev/null; then
		log "Claude Code's own installer failed; the verified ${staged} is kept for the next attempt"
		return 1
	fi
	local installed
	installed="$("${HOME}/.local/bin/claude" --version 2>/dev/null)" || installed=""
	if [ "${installed%% *}" = "$version" ]; then
		log "installed Claude Code ${version} at ${HOME}/.local/bin/claude"
		return 0
	fi
	# T3's /welcome Install (install.sh) can finish between the PATH check and
	# setup; Claude's installer then keeps the launcher it wrote. Any working
	# claude there is a success.
	if [ -n "$installed" ]; then
		log "another installer finished first: ${HOME}/.local/bin/claude is ${installed}; keeping it"
		return 0
	fi
	log "after setup, ${HOME}/.local/bin/claude does not run"
	return 1
}

if $keep_trying; then log "start: Claude Code ${target}, retrying for about a day"; else log "start: Claude Code ${target}"; fi

busy() { log "another install-claude-code is running (log: ~/.local/state/t3code/install-claude-code.log)"; }

status=0
attempt || status=$?
[ "$status" -eq 0 ] && exit 0
[ "$status" -eq 2 ] && busy
$keep_trying || exit 1
for wait in $BACKOFF; do
	log "retrying in ${wait}s"
	sleep "$wait"
	status=0
	attempt || status=$?
	[ "$status" -eq 0 ] && exit 0
	[ "$status" -eq 2 ] && busy
done
log "giving up; run install-claude-code again, or install Claude from T3's /welcome"
exit 1
